# Root .editorconfig for the .NET backend (src/).
# The Angular workspace under web/ has its own .editorconfig with `root = true`,
# so editors resolve web/ files there and never merge into this file.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
